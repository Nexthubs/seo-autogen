# ======================================================
# APP
# ======================================================

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_SECRET_KEY=change-me
APP_TIMEZONE=UTC

DATA_DIR=/app/data

# ======================================================
# DATABASE
# ======================================================

DATABASE_URL=postgresql+psycopg://seo:seo@postgres:5432/seo

# ======================================================
# REDIS / RQ
# ======================================================

REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=seo
# 单个 job 的 RQ worker 超时（秒）。RQ 默认 180s 短于完整 15 步 pipeline 运行时间
# （多次 LLM 调用 + 图片生成），必须显式覆盖（audit H08）。
RQ_JOB_TIMEOUT_SECONDS=3600

# ======================================================
# LLM
# ======================================================

LLM_PROVIDER=openai_compatible

LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=local
# 写作档模型（article_writer / article_reviser）
LLM_MODEL=qwen3.8-27b
# 分析档模型（竞品分析/综合/证据/brief/大纲/三审/配图规划 14 次调用）。
# 留空 = 分析档退回 LLM_MODEL（与拆分前行为一致）。
LLM_MODEL_ANALYSIS=
# 分析档独立端点（可选）：例如写作用 Gemini、分析用 OpenAI。
# 三项均独立留空 = 分析档退回写作档对应值（LLM_BASE_URL / LLM_API_KEY / LLM_MODEL）。
# 任一字段与写作档不同 = 分析档走独立连接（仅配置时才建立第二个客户端）。
LLM_BASE_URL_ANALYSIS=
LLM_API_KEY_ANALYSIS=

LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2

# Structured-output request shape, aligned with Zelig's role configuration:
# json_schema | compat_json_schema | json_object | prompt_only
# Gemma-4-26b should use prompt_only unless the gateway is known to support
# one of the response_format variants. Empty analysis mode inherits this one.
LLM_STRUCTURED_OUTPUT_MODE=prompt_only
LLM_STRUCTURED_OUTPUT_MODE_ANALYSIS=prompt_only

LLM_TEMPERATURE_ANALYSIS=0.25
LLM_TEMPERATURE_WRITING=0.70
LLM_TEMPERATURE_REVIEW=0.20

# ======================================================
# DATAFORSEO
# ======================================================

SERP_PROVIDER=dataforseo

DATAFORSEO_BASE_URL=https://api.dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# standard = queue-based, lower cost; live = synchronous, faster
DATAFORSEO_REQUEST_TYPE=standard
DATAFORSEO_LOCATION_CODE=2840
DATAFORSEO_LANGUAGE_CODE=en
DATAFORSEO_DEVICE=mobile
DATAFORSEO_OS=ios
DATAFORSEO_DEPTH=10

# Standard task polling. Results retrieval is free after task_post.
DATAFORSEO_POLL_INTERVAL_SECONDS=5
DATAFORSEO_POLL_TIMEOUT_SECONDS=3600

# 0 = 不额外点击 PAA，节省成本
DATAFORSEO_PAA_CLICK_DEPTH=0

# V1 不需要为 AI Overview 额外付费
DATAFORSEO_LOAD_ASYNC_AI_OVERVIEW=false
DATAFORSEO_CALCULATE_RECTANGLES=false

# ======================================================
# EXTRACTOR
# ======================================================

CONTENT_EXTRACTOR_PROVIDER=exa

EXA_BASE_URL=https://api.exa.ai
EXA_API_KEY=

TAVILY_BASE_URL=https://api.tavily.com
TAVILY_API_KEY=

SOURCE_CACHE_TTL_HOURS=168
SOURCE_MAX_CHARS=50000

# ======================================================
# IMAGE
# ======================================================

IMAGE_PROVIDER=openai

IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2

IMAGE_QUALITY=medium
IMAGE_MAX_COUNT=3

# ======================================================
# STRAPI
# ======================================================

STRAPI_BASE_URL=https://cms.example.com
STRAPI_API_TOKEN=

# 不要在代码里假定一定叫 blogs
STRAPI_BLOG_PLURAL_API_ID=blogs
STRAPI_BLOG_UID=api::blog.blog
# Author / Category 集合的 pluralApiId（M-3）：不同 Strapi 部署可能不叫 authors/categories
STRAPI_AUTHOR_PLURAL_API_ID=authors
STRAPI_CATEGORY_PLURAL_API_ID=categories

# These are Strapi 5 documentId values (long strings), not numeric database ids.
STRAPI_DEFAULT_AUTHOR_DOCUMENT_ID=
STRAPI_DEFAULT_CATEGORY_DOCUMENT_ID=

STRAPI_AUTHOR_REQUIRED=true
STRAPI_CATEGORY_REQUIRED=true

STRAPI_SET_POSTED_AT_ON_DRAFT=false
STRAPI_FRONTEND_RENDERS_MAIN_IMAGE=true

# ======================================================
# ARTICLE
# ======================================================

ARTICLE_DEFAULT_LANGUAGE=en
ARTICLE_DEFAULT_MARKET=US
ARTICLE_MIN_IMAGE_COUNT=1
ARTICLE_MAX_IMAGE_COUNT=3

SEO_GUIDELINE_PATH=prompts/seo_article_guideline.md
BRAND_VISUAL_GUIDELINE_PATH=prompts/brand_visual_guideline.md

# ======================================================
# OPERATIONS (P9-C)
# ======================================================

# 终态(failed/cancelled) job 保留天数；0 = 永久保留(cleanup 不删 job)
JOB_RETENTION_DAYS=30
# 备份归档保留份数（超出部分自动清理最旧的）
BACKUP_KEEP=14
# 备份目录（留空 = DATA_DIR/backups）
BACKUP_DIR=
